{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "outDir": "dist/server",
    "rootDir": "src",
    "skipLibCheck": true
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts", "src/**/*.d.ts"]
}
